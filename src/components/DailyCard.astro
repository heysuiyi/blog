---
import type { CollectionEntry } from 'astro:content';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { pubDate, daily, title, description } = post.data;
const href = `/blog/${post.id}/`;
const year = pubDate.getUTCFullYear();
const month = String(pubDate.getUTCMonth() + 1).padStart(2, '0');
const day = String(pubDate.getUTCDate()).padStart(2, '0');
const weekday = new Intl.DateTimeFormat('zh-CN', { weekday: 'long', timeZone: 'UTC' }).format(pubDate);
---

<article class="daily-card">
	<div class="date-panel">
		<time datetime={pubDate.toISOString()} aria-label={`${year}年${month}月${day}日 ${weekday}`}>
			<span class="date-month">{year} / {month}</span>
			<span class="date-day">{day}</span>
			<span class="date-weekday">{weekday}</span>
		</time>
		{daily && <span class="issue-label">第 {daily.issue} 期</span>}
	</div>
	<div class="daily-body">
		<span class="series-label">科技与设计学习日报</span>
		<h2><a href={href}>{daily?.headline ?? title}</a></h2>
		<p>{description}</p>
		<a class="daily-read" href={href} aria-label={`阅读本期：${daily?.headline ?? title}`}>
			阅读本期
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
			</svg>
		</a>
	</div>
</article>

<style>
 .daily-card { display: grid; grid-template-columns: 115px minmax(0,1fr); margin-bottom: 24px; border: 1px solid var(--line); background: var(--paper); }
 .date-panel { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; padding: 24px 14px; background: var(--soft); color: var(--teal); }
 time { display: flex; flex-direction: column; align-items: center; font-variant-numeric: tabular-nums; }
 .date-month { font-size: 11px; letter-spacing: .06em; }
 .date-day { font: 500 42px/1.3 var(--serif); margin: 2px 0; }
 .date-weekday,.issue-label { font-size: 11px; color: var(--muted); }
 .daily-body { min-width: 0; padding: 25px 30px; }
 .series-label { display: block; margin-bottom: 8px; color: var(--teal); font-size: 11px; letter-spacing: .06em; }
 h2 { font: 500 22px/1.7 var(--serif); margin: 0 0 10px; }
 h2 a { color: var(--ink); } h2 a:hover { color: var(--teal); }
 p { margin: 0 0 15px; color: var(--muted); font-size: 14px; line-height: 1.95; }
 .daily-read { display: inline-flex; align-items: center; gap: 8px; min-height: 36px; color: var(--teal); font-size: 12px; }
 .daily-read svg { transition: transform .2s; } .daily-read:hover svg { transform: translateX(3px); }
 @media(max-width:600px) { .daily-card { grid-template-columns: 1fr; } .date-panel { flex-direction: row; justify-content: space-between; gap: 8px; padding: 12px 20px; } time { flex-direction: row; flex-wrap: wrap; gap: 5px; } .date-month { font-size: 12px; letter-spacing: 0; } .date-month::after { content: ' /'; } .date-day { margin: 0; font: 12px/1.8 var(--sans); } .date-weekday { margin-left: 6px; } .daily-body { padding: 22px 20px; } h2 { font-size: 21px; } }
</style>
