---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---
<a class="skip-link" href="#main-content">跳到正文</a>
<header class="site-header site-wrap" id="top">
 <div class="header-inner">
  <a href="/" class="brand" aria-label={`${SITE_TITLE} 首页`}>
   <svg aria-hidden="true" viewBox="0 0 24 31" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"><path d="M11 28V9M11 18C4 18 2 13 3 8c6 1 9 5 8 10ZM11 12C11 5 16 2 21 3c0 6-4 10-10 9ZM11 24c0-6 4-10 10-10-1 7-4 10-10 10Z"/></svg>
   <span>{SITE_TITLE}</span>
  </a>
  <nav class="main-nav" aria-label="主导航">
   <HeaderLink href="/">首页</HeaderLink>
   <HeaderLink href="/blog">文章</HeaderLink>
   <HeaderLink href="/daily">日报</HeaderLink>
   <HeaderLink href="/about">关于</HeaderLink>
   <a class="search-link" href="/search/" aria-label="搜索文章" title="搜索文章"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></a>
  </nav>
 </div>
</header>
<style>
 .header-inner { min-height: 100px; display: flex; justify-content: space-between; align-items: center; gap: 24px; border-bottom: 1px solid var(--line); }
 .brand { display: inline-flex; align-items: center; gap: 12px; color: var(--ink); font: 500 29px Georgia,serif; letter-spacing: -1.5px; }
 .brand svg { width: 21px; height: 28px; color: var(--teal); }
 .main-nav { display: flex; align-items: center; gap: 29px; font-size: 13px; letter-spacing: .04em; }
 .main-nav :global(a) { position: relative; min-height: 44px; display: inline-flex; align-items: center; color: var(--muted); }
 .main-nav :global(a:hover),.main-nav :global(a.active) { color: var(--ink); }
 .main-nav :global(a.active)::after { content: ''; position: absolute; width: 4px; height: 4px; background: var(--teal); border-radius: 50%; bottom: 3px; left: 50%; transform: translateX(-50%); }
 @media(max-width:650px) { .header-inner { min-height: 80px; gap: 15px; } .brand { font-size: 25px; gap: 8px; } .brand svg { width: 17px; height: 23px; } .main-nav { gap: 15px; font-size: 12px; } }
 @media(max-width:360px) { .header-inner { flex-wrap: wrap; justify-content: center; padding: 15px 0 10px; gap: 2px 20px; } .main-nav { justify-content: center; } }
</style>
