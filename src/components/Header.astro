---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="poetize-header">
	<nav class="nav-container">
		<div class="brand">
			<a href="/" class="brand-link">
				<span class="brand-icon">🌱</span>
				<span class="brand-text">{SITE_TITLE}</span>
			</a>
		</div>

		<div class="nav-links">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/blog">博客</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
		</div>

		<div class="nav-actions">
			<a href="/rss.xml" class="action-btn" title="RSS 订阅" aria-label="RSS Feed">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M4 11a9 9 0 0 1 9 9"/>
					<path d="M4 4a16 16 0 0 1 16 16"/>
					<circle cx="5" cy="19" r="1"/>
				</svg>
			</a>
			<a href="https://github.com" target="_blank" rel="noopener noreferrer" class="action-btn github-btn" title="GitHub" aria-label="GitHub">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
					<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
				</svg>
			</a>
		</div>
	</nav>
</header>

<style>
	.poetize-header {
		position: sticky;
		top: 0;
		z-index: 100;
		width: 100%;
		background: rgba(255, 255, 255, 0.75);
		backdrop-filter: var(--glass-blur);
		-webkit-backdrop-filter: var(--glass-blur);
		border-bottom: 1px solid rgba(255, 255, 255, 0.8);
		box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.04);
		transition: var(--transition-smooth);
	}

	.nav-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0.85rem 2rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.brand-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
	}

	.brand-icon {
		font-size: 1.35rem;
		transition: transform 0.4s ease;
	}

	.brand-link:hover .brand-icon {
		transform: rotate(20deg) scale(1.15);
	}

	.brand-text {
		font-size: 1.35rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		background: var(--primary-gradient);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}

	.nav-links :global(a) {
		color: var(--text-muted);
		text-decoration: none;
		font-weight: 600;
		font-size: 0.95rem;
		padding: 0.4rem 0.85rem;
		border-radius: var(--radius-full);
		transition: var(--transition-smooth);
		position: relative;
	}

	.nav-links :global(a:hover) {
		color: var(--primary);
		background: rgba(37, 99, 235, 0.08);
	}

	.nav-links :global(a.active) {
		color: var(--primary);
		background: rgba(37, 99, 235, 0.12);
		font-weight: 700;
	}

	.nav-actions {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.action-btn {
		width: 36px;
		height: 36px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--text-muted);
		background: rgba(255, 255, 255, 0.6);
		border: 1px solid var(--card-border-subtle);
		transition: var(--transition-smooth);
	}

	.action-btn:hover {
		color: var(--primary);
		background: rgba(37, 99, 235, 0.1);
		border-color: rgba(37, 99, 235, 0.3);
		transform: translateY(-2px);
	}

	@media (max-width: 640px) {
		.nav-container {
			padding: 0.75rem 1.25rem;
		}
		.nav-links {
			gap: 0.5rem;
		}
	}
</style>
