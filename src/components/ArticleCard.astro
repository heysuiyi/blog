---
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
	post: CollectionEntry<'blog'>;
	index?: number;
}

const { post, index = 0 } = Astro.props;
const isReversed = index % 2 === 1;
const category = post.data.category || '随笔';
---

<article class={`article-card ${isReversed ? 'reversed' : ''}`}>
	<a href={`/blog/${post.id}/`} class="card-cover-link">
		<div class="card-cover">
			{post.data.heroImage ? (
				<Image src={post.data.heroImage} width={480} height={270} alt={post.data.title} class="cover-img" />
			) : (
				<div class="cover-placeholder">
					<span class="placeholder-icon">✦</span>
				</div>
			)}
			<span class="category-tag">{category}</span>
		</div>
	</a>

	<div class="card-body">
		<div class="meta-row">
			<span class="meta-item date">
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
					<line x1="16" x2="16" y1="2" y2="6"/>
					<line x1="8" x2="8" y1="2" y2="6"/>
					<line x1="3" x2="21" y1="10" y2="10"/>
				</svg>
				<FormattedDate date={post.data.pubDate} />
			</span>
		</div>

		<h2 class="card-title">
			<a href={`/blog/${post.id}/`}>{post.data.title}</a>
		</h2>

		<p class="card-desc">{post.data.description}</p>

		<div class="card-footer">
			<a href={`/blog/${post.id}/`} class="read-more">
				<span>阅读全文</span>
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<path d="M5 12h14"/>
					<path d="m12 5 7 7-7 7"/>
				</svg>
			</a>
		</div>
	</div>
</article>

<style>
	.article-card {
		display: flex;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-card);
		overflow: hidden;
		backdrop-filter: var(--glass-blur);
		transition: var(--transition-smooth);
		margin-bottom: 1.75rem;
	}

	.article-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-hover);
		border-color: rgba(37, 99, 235, 0.35);
	}

	.article-card.reversed {
		flex-direction: row-reverse;
	}

	.card-cover-link {
		width: 42%;
		min-width: 240px;
		overflow: hidden;
		display: block;
		position: relative;
	}

	.card-cover {
		position: relative;
		width: 100%;
		height: 100%;
		min-height: 200px;
		overflow: hidden;
	}

	.cover-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s cubic-bezier(0.25, 0.8, 0.25, 1);
	}

	.article-card:hover .cover-img {
		transform: scale(1.06);
	}

	.cover-placeholder {
		width: 100%;
		height: 100%;
		min-height: 200px;
		background: linear-gradient(135deg, rgba(59, 130, 246, 0.15) 0%, rgba(20, 184, 166, 0.15) 100%);
		display: flex;
		align-items: center;
		justify-content: center;
		font-weight: 700;
		color: var(--text-muted);
		font-size: 1.2rem;
		letter-spacing: 0.1em;
	}

	.category-tag {
		position: absolute;
		top: 1rem;
		left: 1rem;
		background: rgba(255, 255, 255, 0.85);
		color: var(--primary);
		padding: 0.25rem 0.75rem;
		border-radius: var(--radius-full);
		font-size: 0.75rem;
		font-weight: 700;
		backdrop-filter: var(--glass-blur);
		box-shadow: var(--shadow-sm);
		z-index: 2;
	}

	.article-card.reversed .category-tag {
		left: auto;
		right: 1rem;
	}

	.card-body {
		width: 58%;
		padding: 1.75rem 2rem;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.meta-row {
		display: flex;
		align-items: center;
		gap: 1rem;
		font-size: 0.82rem;
		color: var(--text-light);
		margin-bottom: 0.6rem;
	}

	.meta-item {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}

	.card-title {
		font-size: 1.35rem;
		line-height: 1.4;
		margin: 0 0 0.75rem 0;
	}

	.card-title a {
		color: var(--text-main);
	}

	.article-card:hover .card-title a {
		color: var(--primary);
	}

	.card-desc {
		color: var(--text-muted);
		font-size: 0.95rem;
		line-height: 1.65;
		margin: 0 0 1.25rem 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.card-footer {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		margin-top: auto;
	}

	.read-more {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--primary);
		transition: var(--transition-smooth);
	}

	.read-more svg {
		transition: transform 0.3s ease;
	}

	.read-more:hover svg {
		transform: translateX(4px);
	}

	@media (max-width: 768px) {
		.article-card,
		.article-card.reversed {
			flex-direction: column;
		}
		.card-cover-link {
			width: 100%;
			min-width: auto;
		}
		.card-cover {
			height: 180px;
			min-height: auto;
		}
		.card-body {
			width: 100%;
			padding: 1.25rem 1.5rem;
		}
		.category-tag {
			left: 1rem !important;
			right: auto !important;
		}
	}
</style>
