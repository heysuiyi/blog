---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_TITLE } from '../consts';
import { Font } from 'astro:assets';
import { themeInitScript } from '../scripts/theme-init';
import { serializeJsonLd } from '../lib/structured-data';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata | string;
	imageAlt?: string;
	imageWidth?: number;
	imageHeight?: number;
	type?: 'website' | 'article';
	pubDate?: Date;
	updatedDate?: Date;
	structuredData?: Record<string, unknown>;
	noindex?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
	title, description, image = FallbackImage, imageAlt = title,
	imageWidth, imageHeight, type = 'website', pubDate, updatedDate,
	structuredData, noindex = false,
} = Astro.props;
const imageURL = new URL(typeof image === 'string' ? image : image.src, Astro.site);
const width = imageWidth ?? (typeof image === 'string' ? undefined : image.width);
const height = imageHeight ?? (typeof image === 'string' ? undefined : image.height);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#f8f7f2" />
<script is:inline set:html={themeInitScript} />
<script>import '../scripts/reading-controls';</script>

<Font cssVariable="--font-atkinson" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, follow" />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="zh_CN" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:alt" content={imageAlt} />
{width && <meta property="og:image:width" content={String(width)} />}
{height && <meta property="og:image:height" content={String(height)} />}
{imageURL.pathname.endsWith('.png') && <meta property="og:image:type" content="image/png" />}
{type === 'article' && pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
{type === 'article' && pubDate && <meta property="article:modified_time" content={(updatedDate ?? pubDate).toISOString()} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:image:alt" content={imageAlt} />
{structuredData && <script is:inline type="application/ld+json" set:html={serializeJsonLd(structuredData)} />}
