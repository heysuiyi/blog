---
const today = new Date();
---

<footer class="poetize-footer">
	<div class="footer-container">
		<div class="poetic-motto">
			<span class="motto-icon">🌸</span>
			<p class="motto-text">三年沉淀，一生所爱 · 诗意栖居的数字花园</p>
		</div>

		<div class="runtime-box">
			<span class="garden-icon">🌱</span>
			<span id="runtime-display">数字花园已静静绽放...</span>
		</div>

		<div class="copyright-line">
			&copy; {today.getFullYear()} <strong>putl</strong>. All rights reserved.
			<span class="divider">/</span>
			Powered by <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a> &amp; Poetize Design
		</div>
	</div>
</footer>

<script>
	// Dynamic running days counter based on site launch
	function updateRuntime() {
		const startDate = new Date('2024-01-01T00:00:00');
		const now = new Date();
		const diff = now.getTime() - startDate.getTime();
		const days = Math.floor(diff / (1000 * 60 * 60 * 24));
		const el = document.getElementById('runtime-display');
		if (el) {
			el.textContent = `数字花园已静静耕耘 ${days} 天`;
		}
	}
	updateRuntime();
</script>

<style>
	.poetize-footer {
		margin-top: auto;
		background: rgba(255, 255, 255, 0.7);
		backdrop-filter: var(--glass-blur);
		-webkit-backdrop-filter: var(--glass-blur);
		border-top: 1px solid rgba(255, 255, 255, 0.8);
		padding: 3rem 1.5rem 2.5rem;
		text-align: center;
		position: relative;
	}

	.footer-container {
		max-width: 800px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.85rem;
	}

	.poetic-motto {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.motto-icon {
		font-size: 1.1rem;
	}

	.motto-text {
		font-size: 0.95rem;
		color: var(--text-muted);
		margin: 0;
		font-style: italic;
	}

	.runtime-box {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.3rem 0.85rem;
		background: rgba(255, 117, 140, 0.08);
		border: 1px solid rgba(255, 117, 140, 0.2);
		border-radius: var(--radius-full);
		font-size: 0.82rem;
		color: #d12e56;
		font-weight: 500;
	}

	.copyright-line {
		font-size: 0.85rem;
		color: var(--text-light);
		margin-top: 0.25rem;
	}

	.copyright-line strong {
		color: var(--text-main);
	}

	.divider {
		margin: 0 0.4rem;
		color: rgba(0, 0, 0, 0.15);
	}

	.copyright-line a {
		color: var(--primary);
		font-weight: 600;
	}

	.copyright-line a:hover {
		text-decoration: underline;
	}
</style>
