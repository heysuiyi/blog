---
import { SITE_TITLE, GITHUB_URL } from '../consts';
---
<footer class="site-footer site-wrap">
 <div class="footer-inner">
  <span>© {new Date().getFullYear()} {SITE_TITLE} · 写下，留下。</span>
  <nav aria-label="更多导航">
   <a href="/categories/">分类</a><a href="/tags/">标签</a><a href="/search/">搜索</a>
   <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">GitHub</a><a href="/rss.xml">RSS</a><a href="#top">回到顶部 ↑</a>
  </nav>
 </div>
</footer>
<style>
 .site-footer { margin-top: auto; }
 .footer-inner { border-top: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 20px 0 28px; font-size: 11px; color: var(--muted); }
 nav { display: flex; flex-wrap: wrap; gap: 4px 18px; } a { display: inline-flex; align-items: center; min-height: 32px; color: var(--muted); } a:hover { color: var(--teal); }
 @media(max-width:650px) { .footer-inner { flex-direction: column; align-items: flex-start; gap: 10px; } nav { gap: 4px 17px; } }
</style>
