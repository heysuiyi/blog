---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { taxonomyEntries, taxonomyUrl } from '../lib/taxonomy';
import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import FormattedDate from './FormattedDate.astro';
import Header from './Header.astro';
import ReadingTools from './ReadingTools.astro';
import { SITE_TITLE } from '../consts';

interface Props {
	allPosts: CollectionEntry<'blog'>[];
	kind?: 'category' | 'tag';
	value?: string;
	directory?: boolean;
	search?: boolean;
}
const { allPosts, kind, value, directory = false, search = false } = Astro.props;
const posts = directory ? [] : value && kind
	? allPosts.filter(p => kind === 'category' ? p.data.category === value : p.data.tags.includes(value))
	: allPosts;
const categories = taxonomyEntries(allPosts, 'category');
const tags = taxonomyEntries(allPosts, 'tag');
const title = search ? '搜索文章' : directory ? (kind === 'category' ? '文章分类' : '文章标签') : value ? (kind === 'category' ? '分类 · ' : '标签 · ') + value : '全部文章与专栏';
const entries = kind === 'tag' ? tags : categories;
const description = search
 ? '搜索 SuiYI 的文章标题、摘要、分类、标签与正文，找到想继续读的主题。'
 : directory
 ? `浏览 SuiYI 的${kind === 'category' ? '文章分类' : '文章标签'}，从 ${entries.length} 个主题入口探索 ${allPosts.length} 篇记录。`
 : value
 ? `阅读 SuiYI「${value}」${kind === 'category' ? '分类' : '标签'}下的 ${posts.length} 篇文章，按时间回看相关记录。`
 : `SuiYI 的文章与专栏归档，共 ${allPosts.length} 篇技术、认知、思维、学习日报与论文解读，支持按分类和标签浏览。`;
---

<!doctype html>
<html lang="zh-CN">
 <head><BaseHead title={`${title} - ${SITE_TITLE}`} description={description} /></head>
 <body>
  <Header />
  <main id="main-content" class="blog-archive-container site-wrap">
   <header class="archive-header">
    <span class="archive-eyebrow">THE ARCHIVE</span>
    <h1>{title}</h1>
    <p class="archive-subtitle">{directory ? `共 ${entries.length} 个${kind === 'category' ? '分类' : '标签'}，收录 ${allPosts.length} 篇文章。` : `共收录 ${posts.length} 篇文字与思考，随时间慢慢积累。`}</p>
    <nav class="category-filters" aria-label="文章分类">
     <a href="/blog/" class:list={['filter-tag', {active: !kind && !search}]} aria-current={!kind && !search ? 'page' : undefined}>全部 ({allPosts.length})</a>
     {categories.map(({name,count}) => <a href={taxonomyUrl('category',name)} class:list={['filter-tag',{active:kind === 'category' && value === name}]} aria-current={kind === 'category' && value === name ? 'page' : undefined}>{name} ({count})</a>)}
     {!categories.some(({name}) => name === '论文解读') && <a href="/papers/" class="filter-tag">论文解读 (0)</a>}
     <a href="/tags/" class:list={['filter-tag',{active:kind === 'tag'}]}>标签 ({tags.length})</a>
     <a href="/search/" class:list={['filter-tag',{active:search}]} aria-current={search ? 'page' : undefined}>搜索</a>
    </nav>
   </header>
   <ReadingTools />
   {directory && <nav class="taxonomy-directory" aria-label={title}>{entries.map(({name,count}) => <a class="directory-tag" href={taxonomyUrl(kind!,name)}>{name}<span>{count}</span></a>)}</nav>}
   {search && <form class="search-form" action="/search/" role="search">
    <label for="article-search">搜索标题、摘要、分类、标签与正文</label>
    <div class="search-controls"><input id="article-search" name="q" type="search" placeholder="例如：材料、概率、铅笔" autocomplete="off" /><button type="submit">搜索</button></div>
    <p id="search-status" role="status" aria-live="polite">输入关键词，开始探索文章。</p>
    <noscript>请启用 JavaScript 使用全文搜索，也可以通过上方分类与标签浏览文章。</noscript>
   </form>}
   <section class="archive-grid" aria-label="文章列表" hidden={directory || search}>
    {posts.map(post => {
     const category = post.data.category || '随笔';
     return <article class="grid-card" data-search={search ? [post.data.title,post.data.description,category,...post.data.tags,post.body || ''].join(' ').normalize('NFKC').toLocaleLowerCase() : undefined}>
      <div class="card-info">
       <div class="card-meta"><FormattedDate date={post.data.pubDate} /><span aria-hidden="true">·</span><a href={taxonomyUrl('category',category)}>{category}</a>{post.data.daily && <span>第 {post.data.daily.issue} 期</span>}</div>
       <h2 class="card-heading"><a href={`/blog/${post.id}/`}>{post.data.daily?.headline ?? post.data.title}</a></h2>
       <p class="card-summary">{post.data.description}</p>
       <nav class="post-tags" aria-label={`${post.data.title}的标签`}>{post.data.tags.map(tag => <a href={taxonomyUrl('tag',tag)}>#{tag}</a>)}</nav>
      </div>
      {post.data.heroImage && <a href={`/blog/${post.id}/`} class="card-thumb-link" tabindex="-1" aria-hidden="true"><Image width={360} height={240} src={post.data.heroImage} layout={post.data.heroImage.format === 'svg' ? 'none' : 'constrained'} widths={post.data.heroImage.format === 'svg' ? undefined : [140, 280, 420]} sizes="140px" loading="lazy" decoding="async" alt="" class="thumb-img" /></a>}
     </article>;
    })}
   </section>
  </main>
  <Footer />
 </body>
</html>
<style>
 .blog-archive-container { padding-top: 48px; padding-bottom: 64px; }
 .archive-header { margin-bottom: 28px; }
 .archive-eyebrow { display: block; color: var(--teal); font-size: 11px; letter-spacing: .14em; margin-bottom: 16px; }
 h1 { margin: 0 0 16px; }
 .archive-subtitle { font-size: 14px; color: var(--muted); margin: 0 0 20px; }
 .category-filters { display: flex; flex-wrap: wrap; gap: 8px 24px; }
 .filter-tag { display: inline-flex; align-items: center; min-height: 36px; font-size: 12px; color: var(--muted); border-bottom: 1px solid transparent; }
 .filter-tag.active { color: var(--teal); border-bottom-color: var(--teal); }
 .archive-grid { max-width: 780px; }
 .grid-card { display: flex; align-items: center; gap: 30px; padding: 26px 0; border-bottom: 1px solid var(--line); }
 .card-info { flex: 1; min-width: 0; }
 .card-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; font-size: 11px; color: var(--muted); margin-bottom: 10px; }
 .card-meta a { color: var(--muted); }
 .card-heading { font-size: 19px; font-weight: 500; line-height: 1.8; margin: 0 0 8px; }
 .card-heading a { color: var(--ink); } .card-heading a:hover { color: var(--teal); }
 .card-summary { color: var(--muted); font-size: 14px; line-height: 1.95; margin: 0; }
 .card-thumb-link { width: 140px; flex-shrink: 0; }
 .thumb-img { width: 140px; height: 100px; object-fit: cover; border-radius: 3px; }
 .post-tags { margin-top: 10px; font-size: 11px; }
 .directory-tag { display: flex; align-items: center; gap: 16px; padding: 12px 16px; font-size: 14px; border: 1px solid var(--line); }
 .directory-tag span { font-size: 11px; color: var(--muted); }
 @media(max-width:650px) { .blog-archive-container { padding-top: 32px; padding-bottom: 42px; } .category-filters { gap: 4px 18px; } .card-heading { font-size: 18px; } .grid-card { gap: 16px; } .card-thumb-link { display: none; } .card-meta,.post-tags { font-size: 12px; } }
</style>
<script src="../scripts/search.ts"></script>
