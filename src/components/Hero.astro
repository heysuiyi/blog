---
import { readingConfig } from '../config/reading';

const { status } = readingConfig;
---

<section class="intro" aria-labelledby="intro-title">
	<div class="intro-copy">
		<div class="greeting-line">
			<p class="greeting">你好，我是 SuiYI。</p>
			{status.enabled && status.text && (
				<span class="static-note">
					<span class="status-label">{status.label}</span>
					<i aria-hidden="true"></i>{status.text}
				</span>
			)}
		</div>
		<h1 id="intro-title">把日常的好奇，<br />慢慢写成答案。</h1>
		<p class="lead">一名软件开发者的个人记录。<br />写技术与思考，也追问身边事物的来龙去脉。</p>
	</div>
	<div class="art-wrap">
		<svg class="intro-art" viewBox="0 0 320 250" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="窗边的书桌、打开的书和一株植物">
			<g stroke-linecap="round" stroke-linejoin="round">
				<path d="M156 35h111v119H156z" fill="#edf0e7" stroke="#b0bbac" stroke-width="1.3" />
				<path d="M165 44h93v101h-93z" fill="#f8f7f2" stroke="#c5cdbe" stroke-width="1" />
				<path d="M210 44v101M165 94h93" stroke="#b7c1b0" stroke-width="1.2" />
				<path d="M166 120c19-20 32-15 44-3 20-22 34-24 48-8" stroke="#c0cabc" stroke-width="1.2" />
				<circle cx="237" cy="67" r="10" fill="#e0e6d8" />
				<path d="M151 155h122" stroke="#9fae98" stroke-width="2" />
				<path d="M152 34l-8 123M271 34l8 123" stroke="#d0d5c8" stroke-width="1" />
				<path d="M40 193h241M64 198l-8 32M260 198l7 32" stroke="#829481" stroke-width="1.6" />
				<path d="M71 189h96l-4-8H75z" fill="#eef0e5" stroke="#93a08a" stroke-width="1.1" />
				<path d="M87 174c12-3 25-2 36 4v-31c-11-6-24-7-36-4z" fill="#f8f7f2" stroke="#789384" stroke-width="1.25" />
				<path d="M123 178c11-4 22-7 35-5l-2-31c-14-2-24 0-33 5z" fill="#f3f4eb" stroke="#789384" stroke-width="1.25" />
				<path d="m94 150 20 3m-20 4 20 3m-20 4 20 3m16-13 19-4m-19 11 19-4m-19 11 19-4" stroke="#b6c3ad" stroke-width="1" />
				<path d="M185 174h20v15h-20z" fill="#e4eade" stroke="#8fa28d" stroke-width="1.25" />
				<path d="M205 177h4a4 4 0 0 1 0 8h-4M192 166c-5-7 5-8 1-15" stroke="#9fb099" stroke-width="1.2" />
				<path d="M235 164h25l-4 26h-17z" fill="#d9e3d3" stroke="#73917f" stroke-width="1.25" />
				<path d="M246 165c1-15 0-29-5-46m5 36c2-11 8-15 14-20m-15 10c-8-9-12-13-20-15" stroke="#72947e" stroke-width="1.35" />
				<path class="plant-leaves" d="M242 132c-13-1-16-9-14-17 11 1 16 7 14 17ZM247 149c0-12 7-18 19-19-1 11-8 18-19 19ZM238 141c-12 0-18-6-19-15 12 0 18 5 19 15ZM244 124c-4-10-1-18 7-23 6 10 2 19-7 23Z" fill="#e1e9d9" stroke="#78977e" stroke-width="1.15" />
				<path d="M77 206h68M222 214h24M173 228h69" stroke="#d8ddcf" stroke-width="1" />
			</g>
		</svg>
		<p class="art-caption">留一点时间，给阅读与好奇。</p>
	</div>
</section>

<style>
	.intro {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 285px;
		align-items: center;
		gap: 60px;
		padding: 58px 0 35px;
	}
	.greeting-line { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-bottom: 14px; }
	.greeting { font-size: 12px; color: var(--teal); letter-spacing: .08em; margin: 0; }
	.static-note { display: inline-flex; align-items: center; gap: 6px; color: var(--muted); font-size: 10px; letter-spacing: .025em; }
	.static-note i { width: 5px; height: 5px; border-radius: 50%; background: var(--teal); opacity: .65; }
	.status-label { border-left: 1px solid var(--line); padding-left: 14px; font-size: 9px; }
	h1 { font: 500 35px/1.65 var(--serif); letter-spacing: .04em; margin: 0 0 18px; color: var(--ink); }
	.lead { font-size: 14px; line-height: 2.05; color: var(--muted); margin: 0; }
	.intro-art { display: block; width: 100%; height: auto; }
	.art-caption { font: 11px/1.85 var(--serif); letter-spacing: .15em; color: var(--muted); text-align: center; margin: 8px 0 0; }
	.plant-leaves { transform-box: fill-box; transform-origin: bottom center; animation: plant-sway 13s ease-in-out infinite alternate; }
	@keyframes plant-sway { from { transform: rotate(-.8deg); } to { transform: rotate(.8deg); } }
	:global(html[data-theme='dark']) .intro-art { opacity: .85; }
	:global(html[data-theme='dark']) .intro-art [fill]:not([fill='none']) { fill: #333f34; }
	:global(html[data-theme='dark']) .intro-art [stroke] { stroke: #91a78b; }
	:global(html[data-theme='dark']) .intro-art circle { fill: #b7ba93; }
	@media (min-width: 1450px) { .intro { padding-top: 66px; } }
	@media (max-width: 850px) { .intro { grid-template-columns: minmax(0, 1fr) 220px; gap: 25px; } h1 { font-size: 30px; } }
	@media (max-width: 650px) {
		.intro { display: block; padding: 36px 0 24px; }
		.greeting-line { gap: 8px; margin-bottom: 12px; }
		.static-note { font-size: 10px; gap: 5px; }
		.status-label { padding-left: 8px; }
		h1 { font-size: 28px; letter-spacing: .025em; margin-bottom: 15px; }
		.lead { line-height: 2; }
		.art-wrap { width: 177px; margin: 14px 2px 0 auto; }
		.intro-art { height: 145px; object-fit: contain; }
		.art-caption { display: none; }
	}
	@media (prefers-reduced-motion: reduce) { .plant-leaves { animation: none; } }
</style>
