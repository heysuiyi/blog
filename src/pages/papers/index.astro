---
import { getCollection } from 'astro:content';
import ArticleCard from '../../components/ArticleCard.astro';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import ReadingTools from '../../components/ReadingTools.astro';
import { sortPostsNewestFirst } from '../../lib/posts';
import { SITE_TITLE } from '../../consts';

const posts = sortPostsNewestFirst(await getCollection('blog', ({ data }) => data.category.trim() === '论文解读'));
const topics = ['研究问题', '核心方法', '实验与证据', '局限与适用边界', '学习与实践'];
const description = '从原始论文出发，拆解研究问题、方法与证据，分清实验结论和工程推论，让阅读落到理解与实践。';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`论文解读 - ${SITE_TITLE}`} description={description} />
	</head>
	<body>
		<Header />
		<main id="main-content" class="daily-container site-wrap">
			<header class="daily-header">
				<span class="daily-eyebrow">PAPER NOTES</span>
				<h1>论文解读</h1>
				<p class="daily-description">{description}</p>
				<ul class="daily-topics" aria-label="论文解读栏目">
					{topics.map((topic) => <li>{topic}</li>)}
				</ul>
			</header>
			<ReadingTools />
			<section aria-labelledby="daily-list-title">
				<div class="daily-list-header">
					<h2 id="daily-list-title">已发布解读</h2>
					<span>共 {posts.length} 篇 · 最新在前</span>
				</div>
				{posts.length > 0 ? (
					posts.map((post, index) => <ArticleCard post={post} index={index} />)
				) : (
					<div class="daily-empty">
						<h3>第一篇论文解读正在准备中</h3>
						<p>审核发布后会在这里按日期归档；每篇附原论文来源、方法解读与适用边界。</p>
					</div>
				)}
			</section>
			<a class="all-posts-link" href="/blog/">浏览全部文章 →</a>
		</main>
		<Footer />
	</body>
</html>

<style>
 .daily-container { padding-top: 48px; padding-bottom: 64px; }
 .daily-header { margin-bottom: 32px; }
 .daily-eyebrow { display: block; color: var(--teal); font-size: 11px; letter-spacing: .14em; margin-bottom: 16px; }
 h1 { margin: 0 0 18px; }
 .daily-description { color: var(--muted); max-width: 44rem; font-size: 14px; line-height: 2; margin: 0 0 22px; }
 .daily-topics { display: flex; flex-wrap: wrap; gap: 8px 18px; list-style: none; padding: 0; margin: 0; color: var(--teal); font-size: 12px; }
 .daily-topics li:not(:last-child)::after { content: '/'; margin-left: 18px; color: var(--line); }
 .daily-list-header { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px; padding-bottom: 16px; margin-bottom: 24px; border-bottom: 1px solid var(--line); }
 .daily-list-header h2 { margin: 0; font-size: 18px; } .daily-list-header span { font-size: 12px; color: var(--muted); }
 .daily-empty { padding: 40px 24px; background: var(--soft); } .daily-empty p { color: var(--muted); }
 .all-posts-link { display: inline-flex; margin-top: 12px; padding: 8px 0; font-size: 13px; }
 @media(max-width:650px) { .daily-container { padding-top: 32px; padding-bottom: 42px; } .daily-topics { font-size: 11px; gap: 6px 12px; } .daily-topics li:not(:last-child)::after { margin-left: 12px; } }
</style>
