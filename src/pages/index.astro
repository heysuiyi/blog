---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import ReadingTools from '../components/ReadingTools.astro';
import { readingConfig } from '../config/reading';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || a.id.localeCompare(b.id),
);
const categoryOf = (post: (typeof allPosts)[number]) => post.data.category.trim() || '随笔';
const personalPosts = allPosts.filter((post) => !['日报', '论文解读'].includes(categoryOf(post)));
const latestPaper = allPosts.find((post) => categoryOf(post) === '论文解读');
const latestDaily = allPosts.find((post) => categoryOf(post) === '日报');
const categories = Array.from(new Set(personalPosts.map(categoryOf)));
const recentIds = new Set(personalPosts.slice(0, 5).map((post) => post.id));
// Keep only the five newest entries needed for each filter in the page HTML.
const candidateIds = new Set(recentIds);
for (const category of categories) {
	personalPosts.filter((post) => categoryOf(post) === category).slice(0, 5)
		.forEach((post) => candidateIds.add(post.id));
}
const filterPosts = personalPosts.filter((post) => candidateIds.has(post.id));
const randomPosts = personalPosts.map((post) => ({
	title: post.data.title,
	href: `/blog/${post.id}/`,
}));
const firstWander = randomPosts.find((post) => post.href === '/blog/opportunity-cost/') ?? randomPosts[0];
const moments = readingConfig.moments.entries.filter((text) => text.trim());
const dateISO = (date: Date) => date.toISOString().slice(0, 10);
const dateLabel = (date: Date) => dateISO(date).replaceAll('-', '.');
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${SITE_TITLE} · 把好奇写下来`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main id="main-content" class="site-wrap">
			<Hero />
			<ReadingTools />
			<div class="home-content">
				<section class="posts" id="articles" aria-labelledby="posts-title">
					<div class="section-head">
						<h2 id="posts-title">最近写下</h2>
						{categories.length > 1 && (
							<div class="filters" role="group" aria-label="文章分类">
								<button class="filter" type="button" data-filter="" aria-pressed="true" aria-controls="article-list" disabled>全部</button>
								{categories.map((category) => (
									<button class="filter" type="button" data-filter={category} aria-pressed="false" aria-controls="article-list" disabled>{category}</button>
								))}
							</div>
						)}
					</div>
					<p id="filter-status" class="sr-only" role="status" aria-atomic="true">显示最近 {recentIds.size} 篇文章</p>
					<div id="article-list">
						{filterPosts.map((post) => (
							<a class="article" data-category={categoryOf(post)} href={`/blog/${post.id}/`} hidden={!recentIds.has(post.id)}>
								<div class="meta"><time datetime={dateISO(post.data.pubDate)}>{dateLabel(post.data.pubDate)}</time><span>{categoryOf(post)}</span></div>
								<h3>{post.data.title}</h3>
								<p>{post.data.description}</p>
							</a>
						))}
						{!personalPosts.length && <p class="empty-state">新的记录，还在慢慢酝酿。</p>}
					</div>
					<div class="articles-footer">
						<a class="text-link" href="/blog/">翻阅全部文章 <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M3 10h13m-5-5 5 5-5 5" /></svg></a>
					</div>
				</section>

				<aside class="aside" aria-label="学习专栏与阅读小记">
					{latestDaily && (
						<>
							<section class="daily" id="daily" aria-labelledby="daily-title">
								<div class="daily-top"><h2 id="daily-title">学习日报</h2><svg class="daily-icon" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M6 4h17v20H6zM3 8v15a1 1 0 0 0 1 1h2M10 9h9M10 13h9M10 17h5" /></svg></div>
								<p class="issue"><time datetime={dateISO(latestDaily.data.pubDate)}>{dateLabel(latestDaily.data.pubDate)}</time>{latestDaily.data.daily && ` · 第 ${latestDaily.data.daily.issue} 期`}</p>
								<h3>{latestDaily.data.daily?.headline ?? latestDaily.data.title}</h3>
								<p class="daily-description">{latestDaily.data.description}</p>
								<a class="text-link" href={`/blog/${latestDaily.id}/`}>读这一期 <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M3 10h13m-5-5 5 5-5 5" /></svg></a>
							</section>
							<div class="daily-archive"><a href="/daily/">往期日报 ↗</a></div>
						</>
					)}
					<section class="margin-note" aria-labelledby="papers-title">
						<h2 id="papers-title">论文解读</h2>
						{latestPaper ? <>
							<h3><a href={`/blog/${latestPaper.id}/`}>{latestPaper.data.title}</a></h3>
							<p>{latestPaper.data.description}</p>
						</> : <p>从原始论文出发，读懂方法、证据与边界。第一篇解读正在准备中。</p>}
						<a class="text-link" href="/papers/">浏览论文解读 ↗</a>
					</section>
					{readingConfig.moments.enabled && moments.length > 0 && (
						<section class="margin-note" aria-labelledby="note-title" data-moments={JSON.stringify(moments)}>
							<div class="note-head"><h2 id="note-title" class="note-label">{readingConfig.moments.label}</h2>{moments.length > 1 && <button class="quiet-button next-note" id="next-note" type="button" aria-label={`换一则${readingConfig.moments.label}`} aria-controls="note-text" disabled>下一则 ↗</button>}</div>
							<p id="note-text" aria-live="polite" aria-atomic="true">{moments[0]}</p>
						</section>
					)}
					{firstWander && (
						<section class="wander" aria-label="随机文章" data-posts={JSON.stringify(randomPosts)}>
							<div class="wander-head"><button class="quiet-button" id="random-walk" type="button" aria-controls="wander-result" disabled><svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M2 5h3c4 0 6 10 10 10h3m-4-3 4 3-4 3M2 15h3c4 0 6-10 10-10h3m-4-3 4 3-4 3" /></svg>随机漫步</button><span class="wander-hint">随手翻一篇</span></div>
							<div aria-live="polite" aria-atomic="true"><a class="wander-result" id="wander-result" href={firstWander.href}><span id="wander-title">{firstWander.title}</span><span class="wander-action">去读这篇 ↗</span></a></div>
						</section>
					)}
				</aside>
			</div>
			<section class="about" id="about" aria-labelledby="about-title">
				<div><h2 id="about-title">一处慢慢积累的地方。</h2><p>我以服务端开发为主，关注 AI Agent，也对生活中具体而微的事物保持好奇。<br />把学习、实践与思考写下来，给未来的自己留一份可以回看的记录。</p></div>
				<a class="text-link" href="/about/">更多关于我 <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M4 16 16 4M4 4h12v12" /></svg></a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<script>
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	function reveal(element: HTMLElement | null) {
		if (!element || reducedMotion.matches) return;
		element.classList.remove('quiet-reveal');
		void element.offsetWidth;
		element.classList.add('quiet-reveal');
	}

	const filters = [...document.querySelectorAll<HTMLButtonElement>('.filter')];
	const rows = [...document.querySelectorAll<HTMLAnchorElement>('#article-list .article')];
	filters.forEach((button) => {
		button.disabled = false;
		button.addEventListener('click', () => {
			const selected = button.dataset.filter ?? '';
			filters.forEach((filter) => filter.setAttribute('aria-pressed', String(filter === button)));
			let visible = 0;
			rows.forEach((row) => {
				const match = !selected || row.dataset.category === selected;
				row.hidden = !match || visible >= 5;
				if (match && visible < 5) visible += 1;
			});
			const status = document.getElementById('filter-status');
			if (status) status.textContent = selected ? `显示「${selected}」最近 ${visible} 篇文章` : `显示最近 ${visible} 篇文章`;
			reveal(document.getElementById('article-list'));
		});
	});

	const noteSection = document.querySelector<HTMLElement>('[data-moments]');
	const nextNote = document.querySelector<HTMLButtonElement>('#next-note');
	const noteText = document.getElementById('note-text');
	if (noteSection && nextNote && noteText) {
		const notes: string[] = JSON.parse(noteSection.dataset.moments ?? '[]');
		let noteIndex = 0;
		nextNote.disabled = notes.length < 2;
		nextNote.addEventListener('click', () => {
			noteIndex = (noteIndex + 1) % notes.length;
			noteText.textContent = notes[noteIndex];
			reveal(noteText);
		});
	}

	const wander = document.querySelector<HTMLElement>('[data-posts]');
	const wanderButton = document.querySelector<HTMLButtonElement>('#random-walk');
	const wanderLink = document.querySelector<HTMLAnchorElement>('#wander-result');
	const wanderTitle = document.getElementById('wander-title');
	if (wander && wanderButton && wanderLink && wanderTitle) {
		const posts: { title: string; href: string }[] = JSON.parse(wander.dataset.posts ?? '[]');
		wanderButton.disabled = posts.length < 2;
		wanderButton.addEventListener('click', () => {
			const pool = posts.filter((post) => post.href !== wanderLink.getAttribute('href'));
			const pick = pool[Math.floor(Math.random() * pool.length)];
			if (!pick) return;
			wanderLink.href = pick.href;
			wanderTitle.textContent = pick.title;
			reveal(wanderLink);
		});
	}
</script>

<style>
	.home-content { display: grid; grid-template-columns: minmax(0, 1fr) 245px; gap: 64px; align-items: start; padding: 8px 0 58px; }
	.posts, .aside { min-width: 0; }
	.section-head { display: flex; align-items: center; justify-content: space-between; gap: 18px; margin-bottom: 5px; padding-bottom: 16px; border-bottom: 1px solid var(--line); }
	h2 { color: var(--ink); font-size: 17px; line-height: 1.85; font-weight: 500; letter-spacing: .08em; margin: 0; }
	.filters { display: flex; gap: 19px; align-items: center; flex-wrap: wrap; justify-content: flex-end; }
	.filter { border: 0; background: none; padding: 4px 0; color: var(--muted); font: 11px/1.85 var(--sans); cursor: pointer; }
	.filter[aria-pressed='true'], .filter:hover { color: var(--teal); }
	.filter[aria-pressed='true']::after { content: ''; display: block; height: 1px; background: var(--teal); margin-top: 1px; }
	.article { display: block; padding: 22px 0 24px; border-bottom: 1px solid var(--line); color: var(--ink); }
	.article[hidden] { display: none; }
	.meta { display: flex; align-items: center; gap: 11px; color: var(--muted); font-size: 11px; line-height: 1.6; letter-spacing: .06em; margin-bottom: 9px; }
	.meta span::before { content: '·'; margin-right: 11px; }
	.article h3 { font-size: 17px; font-weight: 500; line-height: 1.9; letter-spacing: .01em; color: var(--ink); margin: 0 0 7px; }
	.article p { font-size: 14px; color: var(--muted); line-height: 1.95; margin: 0; }
	.article h3, .article p { transition: transform .2s ease, color .2s ease; }
	.article:hover h3 { color: var(--teal); }
	.article:hover h3, .article:hover p { transform: translateX(2px); }
	.articles-footer { display: flex; justify-content: flex-start; margin-top: 24px; }
	.text-link { display: inline-flex; align-items: center; gap: 9px; color: var(--teal); font-size: 12px; }
	.text-link svg { width: 14px; height: 14px; transition: transform .2s; }
	.text-link:hover svg { transform: translateX(3px); }
	.daily { background: var(--soft); padding: 24px 23px 26px; }
	.daily-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 25px; }
	.daily h2 { font-size: 14px; color: var(--teal); letter-spacing: .1em; }
	.daily-icon { width: 24px; height: 24px; color: var(--teal); }
	.daily .issue { color: var(--muted); font-size: 10px; margin: 0 0 10px; letter-spacing: .04em; }
	.daily h3 { font: 500 19px/1.85 var(--serif); letter-spacing: .015em; color: var(--ink); margin: 0 0 14px; }
	.daily-description { font-size: 13px; line-height: 1.95; color: var(--muted); margin: 0 0 22px; }
	.daily .text-link { font-size: 11px; }
	.daily-archive { margin-top: 12px; text-align: right; }
	.daily-archive a { color: var(--muted); font-size: 10px; }
	.daily-archive a:hover { color: var(--teal); }
	.margin-note { padding: 30px 0 0; }
	.note-head, .wander-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
	.note-head { margin-bottom: 12px; }
	.note-label { color: var(--muted); font-size: 10px; letter-spacing: .08em; font-weight: 400; }
	.quiet-button { display: inline-flex; align-items: center; gap: 8px; border: 0; background: none; color: var(--muted); padding: 4px 0; font: 11px/1.7 var(--sans); cursor: pointer; min-height: 30px; }
	.quiet-button:hover { color: var(--teal); }
	.quiet-button:disabled, .filter:disabled { cursor: default; opacity: .5; }
	.next-note { font-size: 10px; }
	.margin-note p { font: 13px/2.05 var(--serif); letter-spacing: .035em; color: var(--muted); min-height: 77px; margin: 0; }
	.wander { margin-top: 23px; padding-top: 20px; border-top: 1px solid var(--line); }
	.wander-hint { font-size: 10px; color: var(--muted); }
	.wander .quiet-button { font-size: 12px; color: var(--teal); }
	.wander-result { display: block; font: 13px/1.9 var(--serif); color: var(--muted); margin-top: 10px; }
	.wander-result:hover { color: var(--teal); }
	.wander-action { display: block; font: 10px/1.8 var(--sans); margin-top: 6px; color: var(--teal); }
	.about { display: grid; grid-template-columns: 1fr auto; gap: 50px; align-items: center; padding: 30px 0 29px; border-top: 1px solid var(--line); }
	.about h2 { font: 16px/1.9 var(--serif); letter-spacing: .06em; margin-bottom: 7px; }
	.about p { font-size: 13px; color: var(--muted); line-height: 1.9; max-width: 560px; margin: 0; }
	.about .text-link { font-size: 11px; white-space: nowrap; }
	.empty-state { color: var(--muted); font-size: 14px; padding: 20px 0; }
	.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
	.quiet-reveal { animation: quiet-reveal .24s ease-out both; }
	@keyframes quiet-reveal { from { opacity: .35; transform: translateY(2px); } to { opacity: 1; transform: translateY(0); } }
	@media (min-width: 1450px) { .home-content { gap: 80px; } }
	@media (max-width: 850px) { .home-content { gap: 32px; grid-template-columns: minmax(0, 1fr) 218px; } .daily { padding: 23px 20px; } .article h3 { font-size: 15px; } }
	@media (max-width: 650px) {
		.home-content { display: flex; flex-direction: column; gap: 33px; padding: 0 0 36px; }
		.posts, .aside { width: 100%; }
		.section-head { padding-bottom: 13px; margin-bottom: 2px; }
		h2 { font-size: 16px; }
		.filters { gap: 18px; }
		.filter, .text-link, .about .text-link, .daily .text-link, .daily-archive a { font-size: 12px; }
		.article { padding: 23px 0 24px; }
		.meta { font-size: 12px; margin-bottom: 8px; }
		.article h3 { font-size: 17px; line-height: 1.8; }
		.article p { line-height: 1.9; }
		.articles-footer { margin-top: 19px; }
		.daily { padding: 23px 24px; }
		.daily-top { margin-bottom: 18px; }
		.daily h3 { font-size: 20px; margin-bottom: 11px; }
		.daily-description { font-size: 14px; max-width: 360px; margin-bottom: 15px; }
		.daily .issue { font-size: 12px; }
		.daily-archive { margin-top: 9px; }
		.margin-note { padding-top: 24px; }
		.margin-note p { font-size: 14px; min-height: 58px; }
		.note-label, .next-note, .wander-hint { font-size: 11px; }
		.quiet-button { min-height: 34px; }
		.wander-result { font-size: 14px; }
		.wander-action { font-size: 12px; }
		.wander { margin-top: 22px; padding-top: 18px; }
		.about { display: block; padding: 25px 0; }
		.about h2 { font-size: 15px; }
		.about p { font-size: 14px; }
		.about .text-link { margin-top: 15px; }
	}
	@media (prefers-reduced-motion: reduce) {
		.quiet-reveal { animation: none; }
		.article h3, .article p, .text-link svg { transition: none; }
		.article:hover h3, .article:hover p, .text-link:hover svg { transform: none; }
	}
</style>
