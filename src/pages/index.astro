---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Sidebar from '../components/Sidebar.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const allPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const recentPosts = allPosts.slice(0, 5);

// Extract distinct categories
const categories = Array.from(new Set(allPosts.map((p) => p.data.category || '随笔')));
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${SITE_TITLE} - 诗意栖居的数字花园`} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<Header />

		<Hero 
			title="记录那些值得留下的东西" 
			subtitle="技术、项目与长期的思考 · 探索与构建"
			description="做出来只是开始。真正有意思的是，在不断构建与文字沉淀的过程中逐渐看清问题。"
		/>

		<main id="main-feed" class="home-container">
			<div class="content-layout">
				<!-- Left Column: Article Feed -->
				<section class="feed-column">
					<div class="feed-header">
						<div class="feed-title-wrap">
							<span class="feed-badge">✦ RECENT POSTS</span>
							<h2 class="feed-title">最新收录文章</h2>
						</div>
						<a href="/blog/" class="view-all-link">
							<span>全部文章</span>
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
								<path d="M5 12h14"/>
								<path d="m12 5 7 7-7 7"/>
							</svg>
						</a>
					</div>

					<div class="posts-list">
						{recentPosts.map((post, index) => (
							<ArticleCard post={post} index={index} />
						))}
					</div>

					<div class="more-action">
						<a href="/blog/" class="btn-more">
							<span>浏览全部 {allPosts.length} 篇归档文章</span>
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M5 12h14"/>
								<path d="m12 5 7 7-7 7"/>
							</svg>
						</a>
					</div>
				</section>

				<!-- Right Column: Sidebar -->
				<div class="sidebar-column">
					<Sidebar postCount={allPosts.length} categories={categories} />
				</div>
			</div>
		</main>

		<Footer />
	</body>
</html>

<style>
	.home-container {
		max-width: 1200px;
		width: 100%;
		margin: 0 auto;
		padding: 3rem 1.5rem 5rem;
	}

	.content-layout {
		display: grid;
		grid-template-columns: 1fr 320px;
		gap: 2.5rem;
		align-items: start;
	}

	.feed-header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		margin-bottom: 2rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid rgba(0, 0, 0, 0.06);
	}

	.feed-badge {
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		color: var(--primary);
		margin-bottom: 0.35rem;
		display: block;
	}

	.feed-title {
		font-size: 1.65rem;
		font-weight: 800;
		margin: 0;
		color: var(--text-main);
	}

	.view-all-link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--text-muted);
		transition: var(--transition-smooth);
	}

	.view-all-link:hover {
		color: var(--primary);
		transform: translateX(3px);
	}

	.posts-list {
		display: flex;
		flex-direction: column;
	}

	.more-action {
		text-align: center;
		margin-top: 2rem;
	}

	.btn-more {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.85rem 2rem;
		background: rgba(255, 255, 255, 0.8);
		border: 1px solid var(--card-border);
		border-radius: var(--radius-full);
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--text-main);
		backdrop-filter: var(--glass-blur);
		box-shadow: var(--shadow-sm);
		transition: var(--transition-smooth);
	}

	.btn-more:hover {
		background: white;
		color: var(--primary);
		transform: translateY(-2px);
		box-shadow: var(--shadow-card);
		border-color: rgba(37, 99, 235, 0.35);
	}

	@media (max-width: 960px) {
		.content-layout {
			grid-template-columns: 1fr;
		}

		.sidebar-column {
			margin-top: 2rem;
		}
	}
</style>
