---
import { getCollection } from 'astro:content';
import ArticleCard from '../../components/ArticleCard.astro';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog', ({ data }) => data.category === '日报'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const topics = ['科研技术与工程新闻', '模型及产品新特性', '模型配置与使用', '架构设计', 'UI 布局'];
const description = '每日整理科技与设计的值得关注之处，从可靠来源出发，把资讯转化为可实践的知识。';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`日报 - ${SITE_TITLE}`} description={description} />
	</head>
	<body>
		<Header />
		<main class="daily-container">
			<header class="daily-header">
				<span class="daily-eyebrow">✦ DAILY LEARNING</span>
				<h1>科技与设计学习日报</h1>
				<p class="daily-description">{description}</p>
				<ul class="daily-topics" aria-label="日报栏目">
					{topics.map((topic) => <li>{topic}</li>)}
				</ul>
			</header>
			<section aria-labelledby="daily-list-title">
				<div class="daily-list-header">
					<h2 id="daily-list-title">往期日报</h2>
					<span>共 {posts.length} 期 · 最新在前</span>
				</div>
				{posts.length > 0 ? (
					posts.map((post, index) => <ArticleCard post={post} index={index} />)
				) : (
					<div class="daily-empty">
						<h3>第一期日报正在准备中</h3>
						<p>发布后会在这里按日期归档，欢迎再来看看。</p>
					</div>
				)}
			</section>
			<a class="all-posts-link" href="/blog/">浏览全部文章 →</a>
		</main>
		<Footer />
	</body>
</html>

<style>
	.daily-container { width: 100%; max-width: 1000px; margin: 0 auto; padding: 3rem 1.5rem 5rem; }
	.daily-header { text-align: center; margin-bottom: 3rem; }
	.daily-eyebrow { display: block; color: var(--primary); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.15em; margin-bottom: 0.6rem; }
	h1 { font-size: clamp(2rem, 4vw, 2.75rem); font-weight: 800; }
	.daily-description { max-width: 40rem; margin: 1rem auto 1.5rem; color: var(--text-muted); }
	.daily-topics { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.6rem; padding: 0; margin: 0; list-style: none; }
	.daily-topics li { padding: 0.35rem 0.9rem; border-radius: var(--radius-full); border: 1px solid var(--card-border-subtle); background: var(--card-bg); color: var(--primary); font-size: 0.85rem; }
	.daily-list-header { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem; padding-bottom: 1rem; margin-bottom: 1.75rem; border-bottom: 1px solid var(--card-border-subtle); }
	.daily-list-header h2 { margin: 0; font-size: 1.5rem; }
	.daily-list-header span { font-size: 0.9rem; color: var(--text-muted); }
	.daily-empty { padding: 3rem 1.5rem; text-align: center; background: var(--card-bg); border: 1px solid var(--card-border); border-radius: var(--radius-lg); box-shadow: var(--shadow-card); }
	.daily-empty p { color: var(--text-muted); margin-bottom: 0; }
	.all-posts-link { display: block; width: fit-content; margin: 2rem auto 0; font-weight: 600; }
	@media (max-width: 640px) { .daily-container { padding-top: 2rem; } }
</style>
