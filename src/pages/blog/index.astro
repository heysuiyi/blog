---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const categories = Array.from(new Set(posts.map((p) => p.data.category || '随笔')));
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`文章归档 - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		
		<main class="blog-archive-container">
			<section class="archive-header">
				<span class="archive-eyebrow">✦ DIGITAL GARDEN ARCHIVE</span>
				<h1 class="archive-title">全部文章与专栏</h1>
				<p class="archive-subtitle">
					共收录 {posts.length} 篇文字与思考，随时间沉淀生息。
				</p>

				<div class="category-filters">
					<span class="filter-tag active">全部 ({posts.length})</span>
					{categories.map((cat) => (
						<span class="filter-tag">{cat}</span>
					))}
				</div>
			</section>

			<section class="archive-grid">
				{posts.map((post) => {
					const category = post.data.category || '随笔';
					return (
						<article class="grid-card">
							<a href={`/blog/${post.id}/`} class="card-thumb-link">
								<div class="card-thumb">
									{post.data.heroImage ? (
										<Image width={720} height={360} src={post.data.heroImage} alt="" class="thumb-img" />
									) : (
										<div class="thumb-placeholder">
											<span>✦</span>
										</div>
									)}
									<span class="category-pill">{category}</span>
								</div>
							</a>

							<div class="card-info">
								<div class="card-meta">
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
										<line x1="16" x2="16" y1="2" y2="6"/>
										<line x1="8" x2="8" y1="2" y2="6"/>
										<line x1="3" x2="21" y1="10" y2="10"/>
									</svg>
									<FormattedDate date={post.data.pubDate} />
								</div>

								<h2 class="card-heading">
									<a href={`/blog/${post.id}/`}>{post.data.title}</a>
								</h2>

								<p class="card-summary">{post.data.description}</p>
							</div>
						</article>
					);
				})}
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	.blog-archive-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 3rem 1.5rem 5rem;
		width: 100%;
	}

	.archive-header {
		text-align: center;
		margin-bottom: 3.5rem;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.archive-eyebrow {
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.15em;
		color: var(--primary);
		margin-bottom: 0.5rem;
	}

	.archive-title {
		font-size: clamp(2rem, 4vw, 2.75rem);
		font-weight: 800;
		margin: 0 0 0.8rem 0;
	}

	.archive-subtitle {
		font-size: 1.05rem;
		color: var(--text-muted);
		margin: 0 0 2rem 0;
	}

	.category-filters {
		display: flex;
		gap: 0.6rem;
		flex-wrap: wrap;
		justify-content: center;
	}

	.filter-tag {
		padding: 0.4rem 1rem;
		border-radius: var(--radius-full);
		font-size: 0.85rem;
		font-weight: 600;
		background: rgba(255, 255, 255, 0.7);
		border: 1px solid var(--card-border-subtle);
		color: var(--text-muted);
		backdrop-filter: var(--glass-blur);
		cursor: pointer;
		transition: var(--transition-smooth);
	}

	.filter-tag:hover {
		border-color: var(--primary);
		color: var(--primary);
	}

	.filter-tag.active {
		background: var(--primary-gradient);
		color: white;
		border-color: transparent;
		box-shadow: 0 4px 12px rgba(37, 99, 235, 0.35);
	}

	.archive-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
		gap: 2rem;
	}

	.grid-card {
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-card);
		overflow: hidden;
		backdrop-filter: var(--glass-blur);
		transition: var(--transition-smooth);
		display: flex;
		flex-direction: column;
	}

	.grid-card:hover {
		transform: translateY(-5px);
		box-shadow: var(--shadow-hover);
		border-color: rgba(37, 99, 235, 0.35);
	}

	.card-thumb-link {
		display: block;
		overflow: hidden;
		position: relative;
	}

	.card-thumb {
		position: relative;
		width: 100%;
		height: 200px;
		overflow: hidden;
	}

	.thumb-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s cubic-bezier(0.25, 0.8, 0.25, 1);
	}

	.grid-card:hover .thumb-img {
		transform: scale(1.06);
	}

	.thumb-placeholder {
		width: 100%;
		height: 100%;
		background: linear-gradient(135deg, rgba(59, 130, 246, 0.15) 0%, rgba(20, 184, 166, 0.15) 100%);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--text-muted);
		font-weight: 700;
	}

	.category-pill {
		position: absolute;
		top: 0.85rem;
		right: 0.85rem;
		background: rgba(255, 255, 255, 0.88);
		color: var(--primary);
		padding: 0.25rem 0.75rem;
		border-radius: var(--radius-full);
		font-size: 0.75rem;
		font-weight: 700;
		backdrop-filter: var(--glass-blur);
		box-shadow: var(--shadow-sm);
	}

	.card-info {
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		flex: 1;
	}

	.card-meta {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.82rem;
		color: var(--text-light);
		margin-bottom: 0.6rem;
	}

	.card-heading {
		font-size: 1.25rem;
		margin: 0 0 0.6rem 0;
		line-height: 1.4;
	}

	.card-heading a {
		color: var(--text-main);
	}

	.grid-card:hover .card-heading a {
		color: var(--primary);
	}

	.card-summary {
		color: var(--text-muted);
		font-size: 0.92rem;
		line-height: 1.6;
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	@media (max-width: 640px) {
		.archive-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
