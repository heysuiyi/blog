---
import { taxonomyUrl } from '../lib/taxonomy';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import ReadingTools from '../components/ReadingTools.astro';
import { SITE_TITLE } from '../consts';
import { socialImagePath, socialImageAlt, SOCIAL_IMAGE_WIDTH, SOCIAL_IMAGE_HEIGHT } from '../lib/social-image';

type PostData = CollectionEntry<'blog'>['data'];
type Props = Omit<PostData, 'category' | 'tags'> & Partial<Pick<PostData, 'category' | 'tags'>> & {
	postId?: string;
	readingMinutes?: number;
	previousPost?: { title: string; href: string };
	nextPost?: { title: string; href: string };
};

const { title, description, pubDate, updatedDate, heroImage, category, tags = [], postId, readingMinutes, previousPost, nextPost } = Astro.props;
const articleURL = new URL(Astro.url.pathname, Astro.site).href;
const socialImage = postId ? socialImagePath(postId) : heroImage;
const shareAlt = postId ? socialImageAlt({ title, category: category ?? '随笔', pubDate }) : title;
const sectionPath = category === '日报' ? '/daily/' : '/blog/';
const sectionName = category === '日报' ? '学习日报' : '文章';
// The About page also uses this layout, but is not a dated blog post.
const structuredData = postId ? {
	'@context': 'https://schema.org',
	'@graph': [{
		'@type': 'BlogPosting', '@id': `${articleURL}#article`,
		mainEntityOfPage: { '@type': 'WebPage', '@id': articleURL },
		headline: title, description, url: articleURL,
		image: [new URL(socialImagePath(postId), Astro.site).href],
		datePublished: pubDate.toISOString(), dateModified: (updatedDate ?? pubDate).toISOString(),
		author: { '@type': 'Person', name: SITE_TITLE, url: new URL('/about/', Astro.site).href },
		inLanguage: 'zh-CN', articleSection: category, keywords: tags.join(', '),
	}, {
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: '首页', item: new URL('/', Astro.site).href },
			{ '@type': 'ListItem', position: 2, name: sectionName, item: new URL(sectionPath, Astro.site).href },
			{ '@type': 'ListItem', position: 3, name: title, item: articleURL },
		],
	}],
} : undefined;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} image={socialImage} imageAlt={shareAlt}
			imageWidth={postId ? SOCIAL_IMAGE_WIDTH : undefined} imageHeight={postId ? SOCIAL_IMAGE_HEIGHT : undefined}
			type={postId ? 'article' : 'website'} pubDate={postId ? pubDate : undefined}
			updatedDate={updatedDate} structuredData={structuredData} />
	</head>

	<body>
		<!-- Reading Progress Bar -->
		<div id="reading-progress" class="reading-progress-bar"></div>

		<Header />

		<main id="main-content" class="post-layout">
			<ReadingTools />
			<article class="post-article">
				<!-- Hero Header Section -->
				<header class="article-hero">
					<div class="article-meta">
						{category && <a class="category-badge" href={taxonomyUrl('category', category)}>{category}</a>}
						<span class="meta-date">
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
								<line x1="16" x2="16" y1="2" y2="6"/>
								<line x1="8" x2="8" y1="2" y2="6"/>
								<line x1="3" x2="21" y1="10" y2="10"/>
							</svg>
							<FormattedDate date={pubDate} />
						</span>
						{updatedDate && (
							<span class="meta-updated">
								(更新于 <FormattedDate date={updatedDate} />)
							</span>
						)}
						{readingMinutes && <span class="reading-time" title="按正文长度估算，实际阅读时间因人而异">约 {readingMinutes} 分钟阅读</span>}
					</div>

					<h1 class="article-title">{title}</h1>
					{description && <p class="article-desc">{description}</p>}

					{heroImage && (
						<div class="hero-cover-wrap">
							<Image width={1020} height={510} src={heroImage} alt={title} class="hero-cover-img"
								layout={heroImage.format === 'svg' ? 'none' : 'constrained'}
								widths={heroImage.format === 'svg' ? undefined : [384, 768, 1020, 1530]}
								sizes="(max-width: 650px) calc(100vw - 50px), (max-width: 850px) calc(100vw - 84px), 766px"
								loading={postId ? 'eager' : 'lazy'} fetchpriority={postId ? 'high' : 'auto'} decoding="async" />
						</div>
					)}
				</header>

				<!-- Article Body -->
				<div class="article-content prose">
					<slot />
				</div>

				<nav class="post-tags" aria-label="文章标签">{tags.map(tag => <a href={taxonomyUrl('tag', tag)}>#{tag}</a>)}</nav>
				{(previousPost || nextPost) && <nav class="adjacent-posts" aria-label={category === '日报' ? '相邻日报' : '相邻文章'}>
					{previousPost ? <a href={previousPost.href} rel="prev"><span>{category === '日报' ? '上一期' : '上一篇'}</span><strong>{previousPost.title}</strong></a> : <span />}
					{nextPost && <a href={nextPost.href} rel="next"><span>{category === '日报' ? '下一期' : '下一篇'}</span><strong>{nextPost.title}</strong></a>}
				</nav>}
				<!-- Post Navigation Footer -->
				<div class="post-bottom-nav">
					<a href={category === '日报' ? '/daily/' : '/blog'} class="back-link">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="m15 18-6-6 6-6"/>
						</svg>
						<span>{category === '日报' ? '返回日报列表' : '返回文章列表'}</span>
					</a>
				</div>
			</article>
		</main>

		<Footer />

		<script>
			// Reading progress indicator
			window.addEventListener('scroll', () => {
				const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
				const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
				const scrolled = height > 0 ? Math.min(100, Math.max(0, winScroll / height * 100)) : 0;
				const progressBar = document.getElementById('reading-progress');
				if (progressBar) {
					progressBar.style.width = scrolled + '%';
				}
			});
		</script>
	</body>
</html>

<style>
 .reading-progress-bar { position: fixed; top: 0; left: 0; height: 2px; width: 0%; background: var(--teal); z-index: 999; }
 .post-layout { width: 100%; max-width: 850px; padding: 32px 42px 64px; margin: 0 auto; }
 .post-article { padding-top: 18px; }
 .article-hero { padding: 14px 0 32px; margin-bottom: 32px; border-bottom: 1px solid var(--line); }
 .article-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; font-size: 12px; color: var(--muted); margin-bottom: 20px; }
 .category-badge { color: var(--teal); border-right: 1px solid var(--line); padding-right: 16px; }
 .meta-date { display: inline-flex; align-items: center; gap: 6px; }
 .meta-date svg { display: none; }
 .article-title { font: 500 clamp(27px,3.5vw,36px)/1.65 var(--serif); letter-spacing: .025em; margin: 0 0 20px; text-wrap: pretty; }
 .article-desc { color: var(--muted); font-size: 15px; line-height: 2; margin: 0; }
 .hero-cover-wrap { margin-top: 28px; }
 .hero-cover-img { width: 100%; max-height: 380px; object-fit: cover; border-radius: 3px; }
 .article-content { font-size: 16px; line-height: 2; }
 .article-content :global(h2) { font: 500 24px/1.65 var(--serif); margin: 2.8rem 0 1.2rem; padding-bottom: .6rem; border-bottom: 1px solid var(--line); }
 .article-content :global(h3) { font-size: 19px; font-weight: 500; margin: 2rem 0 .8rem; }
 .article-content :global(h2[id]),.article-content :global(h3[id]) { scroll-margin-top: 2rem; }
 .article-content :global(p) { margin: 0 0 1.4rem; }
 .article-content :global(a) { text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--line); }
 .article-content :global(a:hover) { text-decoration-color: var(--teal); }
 .article-content :global(img) { margin: 1.8rem auto; border-radius: 3px; background: #f8f7f2; }
 .article-content :global(ul),.article-content :global(ol) { padding-left: 1.4rem; margin-bottom: 1.5rem; }
 .article-content :global(li) { margin-bottom: .5rem; }
 .article-content :global(table) { width: 100%; display: block; overflow-x: auto; border-collapse: collapse; font-size: .9em; margin: 1.5rem 0; }
 .article-content :global(th),.article-content :global(td) { padding: .55rem .8rem; border: 1px solid var(--line); min-width: 85px; }
 .article-content :global(th) { background: var(--soft); font-weight: 500; }
 .post-tags { padding-top: 16px; border-top: 1px solid var(--line); }
 .post-bottom-nav { margin-top: 32px; }
 .adjacent-posts { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 30px; padding-top: 26px; border-top: 1px solid var(--line); }
 .adjacent-posts a { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
 .adjacent-posts a:last-child { text-align: right; }
 .adjacent-posts span { color: var(--muted); font-size: 12px; }
 .adjacent-posts strong { color: var(--ink); font-size: 15px; font-weight: 500; line-height: 1.8; }
 .adjacent-posts a:hover strong { color: var(--teal); }
 .back-link { display: inline-flex; align-items: center; gap: 8px; padding: 8px 0; font-size: 13px; }
 @media(max-width:650px) { .post-layout { padding: 24px 25px 45px; } .article-title { font-size: 27px; } .article-content { font-size: 16px; } .article-content :global(h2) { font-size: 22px; } .article-desc { font-size: 14px; } }
 @media(max-width:480px) { .adjacent-posts { grid-template-columns: 1fr; gap: 20px; } .adjacent-posts > span { display: none; } .adjacent-posts a:last-child { text-align: left; } }
</style>
